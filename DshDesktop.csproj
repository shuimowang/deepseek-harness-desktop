<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeepSeekHarness</AssemblyName>
    <RootNamespace>DshDesktop</RootNamespace>
    <Version>1.2.0</Version>
    <Authors>DeepSeek Harness Desktop contributors</Authors>
    <Product>DeepSeek Harness Community Desktop</Product>
    <Description>Unofficial community Windows desktop client for DeepSeek Harness.</Description>
    <Copyright>Copyright (c) 2026 DeepSeek Harness Desktop contributors</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>dsh.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**</DefaultItemExcludes>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="dsh.ico" />
    <Resource Include="dsh.ico" />
  </ItemGroup>
</Project>
